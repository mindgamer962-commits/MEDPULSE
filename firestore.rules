rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // MVP Security Rules: Enforce schema and immutability where possible
    // Note: Full role-based access control requires Firebase Auth integration (planned for future phases)
    
    match /phcs/{phcId} {
      allow read: if true;
      allow write: if false; // Only admin can modify PHCs
    }
    
    match /medicines/{medicineId} {
      allow read: if true;
      allow write: if false; // Only admin can modify medicines
    }
    
    match /stock_transactions/{txId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['phc_id', 'medicine_id', 'transaction_type', 'quantity', 'timestamp'])
                    && request.resource.data.quantity is number 
                    && request.resource.data.quantity >= 0 
                    && request.resource.data.transaction_type in ['RECEIVED', 'USED', 'TRANSFER_IN', 'TRANSFER_OUT'];
      allow update, delete: if false; // Append-only ledger
    }
    
    match /daily_footfall/{footfallId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['phc_id', 'date', 'patient_count'])
                    && request.resource.data.patient_count is number 
                    && request.resource.data.patient_count >= 0;
      allow update, delete: if false; // Append-only ledger
    }
    
    match /transfer_recommendations/{recId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll([
                        'destination_phc_id',
                        'medicine_id',
                        'status'
                      ])
                      && request.resource.data.status in [
                        'PENDING APPROVAL',
                        'RECOMMENDED',
                        'APPROVED',
                        'REJECTED'
                      ]
                      && (
                        (
                          request.resource.data.keys().hasAll([
                            'source_phc_id',
                            'recommended_quantity'
                          ])
                          && request.resource.data.recommended_quantity is number
                          && request.resource.data.recommended_quantity > 0
                        )
                        ||
                        (
                          request.resource.data.keys().hasAll([
                            'allocations',
                            'total_quantity'
                          ])
                          && request.resource.data.total_quantity is number
                          && request.resource.data.total_quantity > 0
                        )
                      );
      allow update: if request.resource.data.status in ['APPROVED', 'REJECTED'];
      allow delete: if false;
    }

    match /states/{stateId} {
      allow read: if true;
      allow write: if false;
    }

    match /districts/{districtId} {
      allow read: if true;
      allow write: if false;
    }

    match /beds/{bedId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['phc_id', 'total_beds', 'occupied_beds', 'available_beds'])
                            && request.resource.data.phc_id == bedId
                            && request.resource.data.total_beds is number
                            && request.resource.data.total_beds >= 0
                            && request.resource.data.occupied_beds is number
                            && request.resource.data.occupied_beds >= 0
                            && request.resource.data.occupied_beds <= request.resource.data.total_beds
                            && request.resource.data.available_beds is number
                            && request.resource.data.available_beds == (request.resource.data.total_beds - request.resource.data.occupied_beds)
                            && (!request.resource.data.keys().hasAny(['emergency_beds']) || (request.resource.data.emergency_beds is number && request.resource.data.emergency_beds >= 0 && request.resource.data.emergency_beds <= request.resource.data.total_beds))
                            && (!request.resource.data.keys().hasAny(['icu_beds']) || (request.resource.data.icu_beds is number && request.resource.data.icu_beds >= 0 && request.resource.data.icu_beds <= request.resource.data.total_beds));
      allow delete: if false;
    }

    match /staff/{staffId} {
      allow read: if true;
      allow write: if false;
    }

    match /staff_attendance/{attId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['staff_id', 'phc_id', 'date', 'status'])
                    && request.resource.data.status in ['PRESENT', 'ABSENT', 'LATE', 'AUTHORIZED_LEAVE'];
      allow update, delete: if false;
    }

    match /workforce_dataset_metadata/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /workforce_metadata/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
